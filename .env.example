TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=copier
SOURCE_CHANNELS=          # comma list: @chan1,-1001234567,@chan2
SOURCE_TOPIC_IDS=         # optional forum filter: -1001234567:5,12  (blank = all topics)
REACT_TO_EDITS=true
CONTROL_BOT_TOKEN=
ALLOWED_USER_ID=
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-haiku-4-5-20251001
MIN_CONFIDENCE=0.75
RISK_PCT=0.01
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=10
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.05
MARGIN_MODE=isolated
ENTRY_ORDER_TYPE=limit
MAX_SLIPPAGE_PCT=0.3
ENTRY_FILL_TIMEOUT_MIN=30
TP_SPLIT=equal
MOVE_SL_TO_BE_AFTER_TP1=true
ON_INSUFFICIENT_MARGIN=skip      # skip | reduce
ON_SYMBOL_COLLISION=skip         # skip | allow_same_side | subaccount
FALLBACK_STOP_PCT=
MODE=DRY_RUN                     # DRY_RUN | TESTNET | LIVE
CONFIRM_LIVE=                    # must equal I_UNDERSTAND for LIVE
